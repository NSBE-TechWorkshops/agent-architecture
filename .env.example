# Copy this file to ".env" and fill in what you need.
# The email source can run with mock data, but the agent run needs an LLM key
# because this version demonstrates true model-decided tool calling.

# --- LLM ---
# Required for POST /agent/run and POST /agent/stream.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Where emails come from ---
#   mock  -> sample emails in data/sample_emails.json (default, no setup)
#   gmail -> your real inbox (needs secrets/token.json, see README)
EMAIL_SOURCE=mock
GMAIL_MAX_RESULTS=25

# --- Demo polish ---
# Pause (in seconds) between agent steps in the live stream, so the audience can follow along.
DEMO_STEP_DELAY=0.8
